{
  "name": "kn1ghts-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "emulators": "firebase emulators:start --project demo-kn1ghts --only auth,database",
    "bootstrap": "node scripts/bootstrap.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "firebase-tools": "15.36.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "gaxios": {
      "uuid": "^11.1.1"
    },
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
