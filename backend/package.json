{
  "name": "kn1ghts-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "emulators": "firebase emulators:start --project demo-kn1ghts --only auth,database",
    "bootstrap": "node scripts/bootstrap.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "next": "^16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "firebase-tools": "15.32.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "gaxios": { "uuid": "^11.1.1" },
    "jwks-rsa": { "jose": "5.10.0" }
  }
}
