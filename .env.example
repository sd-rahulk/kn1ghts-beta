# Public website. Use the SAME Firebase database as backend/.env.local.
FIREBASE_DATABASE_URL=
BACKEND_URL=http://localhost:3001
PUBLIC_SITE_ORIGIN=http://localhost:3000
# Firebase web configuration for public email/password accounts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=
NEXT_PUBLIC_DISCORD_URL=
# Must match backend/CONTACT_API_SECRET. Server only.
CONTACT_API_SECRET=
# Must match backend/PLATFORM_API_SECRET. Server only.
PLATFORM_API_SECRET=
# Set ONLY to an IP header your deployment proxy overwrites.
CONTACT_TRUSTED_IP_HEADER=
# Local database emulator only, e.g. demo-kn1ghts-default-rtdb.
FIREBASE_DATABASE_NAMESPACE=

# Optional private access to the old cinematic homepage at /beta.
# Set a fresh, random, high-entropy value (at least 24 characters) in the PUBLIC
# Vercel project; never use a real user's password or commit this secret.
# Example generation: openssl rand -hex 24
# If absent or too short, /beta fails closed. Rotate to invalidate all sessions.
BETA_ACCESS_PASSWORD=
